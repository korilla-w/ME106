                <lv_label text="&#x67E5;&#x8BE2;&#x4E2D;" align="center" width="64"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
            <lv_button name="upgrade_action_busy_start" x="248" y="154" width="64" height="45">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="4"/>
                <lv_label text="&#x542F;&#x52A8;&#x4E2D;" align="center" width="64"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
            <lv_button name="upgrade_action_busy_download" x="248" y="154" width="64" height="45">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="5"/>
                <lv_label text="&#x4E0B;&#x8F7D;&#x4E2D;" align="center" width="64"><style name="me106_text_14_gray_ba"/></lv_label>
