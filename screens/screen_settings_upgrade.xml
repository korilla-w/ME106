<screen>
    <styles>
        <!-- OTA 独立版式：顶部小图标与标题共用一行，样式继续复用三套整机主题。 -->
        <style name="upgrade_title" text_color="#meter_white" text_font="meter_Harmony_Sans_SC_Medium_18" />
        <style name="upgrade_separator" bg_color="#meter_gray_30" bg_opa="255" border_width="0" />
        <style name="upgrade_hint" text_color="#meter_gray_ba" text_font="meter_Harmony_Sans_SC_Medium_14" text_line_space="8" />
    </styles>
    <view width="320" height="240" style_pad_all="0" style_border_width="0" scrollable="false">
        <style name="me106_fill_black" />
        <bind_style name="me106_theme_light_screen_bg" subject="meter_theme_index" ref_value="1" />
        <bind_style name="me106_theme_alarm_screen_bg" subject="meter_theme_index" ref_value="2" />
        <!-- 进入页面只清理一次性 UI 意图；平台准备、查询与状态刷新由应用层接入。 -->
        <subject_set_int_event subject="meter_upgrade_request" value="0" trigger="screen_loaded" />
        <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="screen_loaded" />
        <lv_obj name="page_content" x="0" y="0" width="320" height="207" style_border_width="0" style_pad_all="0" scrollable="false" style_bg_opa="0">
            <lv_image name="upgrade_header_icon" src="meter_icon_update" x="16" y="12">
                <style name="me106_theme_dark_info_icon" />
                <bind_style name="me106_theme_light_info_icon" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_info_icon" subject="meter_theme_index" ref_value="2" />
            </lv_image>
            <lv_label name="settings_upgrade_title_label" x="48" y="11" width="248" height="26" long_mode="clip" text="固件升级">
                <style name="upgrade_title" />
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_obj name="upgrade_header_separator" x="16" y="44" width="288" height="1" style_border_width="0" style_pad_all="0" scrollable="false">
                <style name="upgrade_separator" />
                <bind_style name="me106_theme_light_line" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_line" subject="meter_theme_index" ref_value="2" />
            </lv_obj>
            <lv_label name="upgrade_status_value" x="24" y="55" width="272" height="24" long_mode="dots" bind_text="meter_upgrade_status_text">
                <style name="me106_text_16_cyan" />
                <bind_style name="me106_theme_light_info_text" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_info_text" subject="meter_theme_index" ref_value="2" />
                <bind_flag_if_eq subject="meter_upgrade_status_error" flag="hidden" ref_value="1" />
            </lv_label>
            <lv_label name="upgrade_status_error_value" x="24" y="55" width="272" height="24" long_mode="dots" bind_text="meter_upgrade_status_text">
                <style name="me106_text_16_red" />
                <bind_style name="me106_theme_light_status_danger" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_status_danger" subject="meter_theme_index" ref_value="2" />
                <bind_flag_if_not_eq subject="meter_upgrade_status_error" flag="hidden" ref_value="1" />
            </lv_label>
            <!-- 未联网、连接/查询中或失败时显示提示；去联网只负责导航，不接入 WiFi 驱动。 -->
            <lv_obj name="upgrade_hint_group" x="0" y="0" width="320" height="207" style_border_width="0" style_pad_all="0" scrollable="false" clickable="false" style_bg_opa="0">
                <bind_flag_if_eq subject="meter_upgrade_show_firmware" flag="hidden" ref_value="1" />
                <lv_label name="upgrade_hint_value" x="24" y="96" width="272" height="60" long_mode="wrap" bind_text="meter_upgrade_hint_text">
                    <style name="upgrade_hint" />
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_label name="upgrade_hint_current_label" x="24" y="174" width="76" height="22" text="当前版本">
                    <style name="me106_text_14_gray_ba" />
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_label name="upgrade_hint_current_value" x="108" y="174" width="188" height="22" long_mode="dots" bind_text="meter_upgrade_current_version">
                    <style name="me106_text_16_white_right" />
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
                </lv_label>
            </lv_obj>
            <!-- 固件区域只创建一次；发现固件后保留版本和大小，下载时仅更新进度。 -->
            <lv_obj name="upgrade_firmware_group" x="0" y="0" width="320" height="207" style_border_width="0" style_pad_all="0" scrollable="false" clickable="false" style_bg_opa="0">
                <bind_flag_if_not_eq subject="meter_upgrade_show_firmware" flag="hidden" ref_value="1" />
                <!-- 面板内偏移 8px，使标签左边与大小/进度统一在屏幕 x=24；数值右边统一在 x=296。 -->
                <lv_obj name="upgrade_version_band" x="16" y="84" width="288" height="54" style_border_width="0" style_pad_all="0" scrollable="false">
                    <style name="me106_panel_soft_r8" />
                    <bind_style name="me106_theme_light_soft_panel" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_soft_panel" subject="meter_theme_index" ref_value="2" />
                    <lv_label name="settings_upgrade_current_version_label" x="8" y="4" width="76" height="22" text="当前版本">
                        <style name="me106_text_14_gray_8f" />
                        <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                        <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                    </lv_label>
                    <lv_label name="upgrade_current_version_value" x="92" y="4" width="188" height="22" long_mode="dots" style_text_align="right" bind_text="meter_upgrade_current_version">
                        <style name="me106_text_16_white_right" />
                        <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                        <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
                    </lv_label>
                    <lv_label name="settings_upgrade_target_version_label" x="8" y="28" width="76" height="22" text="目标版本">
                        <style name="me106_text_14_gray_8f" />
                        <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                        <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                    </lv_label>
                    <lv_label name="upgrade_new_version_value" x="92" y="28" width="188" height="22" long_mode="dots" style_text_align="right" bind_text="meter_upgrade_new_version">
                        <style name="me106_text_16_cyan" />
                        <bind_style name="me106_theme_light_info_text" subject="meter_theme_index" ref_value="1" />
                        <bind_style name="me106_theme_alarm_info_text" subject="meter_theme_index" ref_value="2" />
                    </lv_label>
                </lv_obj>
                <lv_label name="settings_upgrade_firmware_size_label" x="24" y="145" width="100" height="20" text="固件大小">
                    <style name="me106_text_14_gray_ba" />
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_label name="upgrade_file_size_value" x="160" y="145" width="136" height="20" long_mode="dots" bind_text="meter_upgrade_file_size_text">
                    <style name="me106_text_14_gray_ba_right" />
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_label name="upgrade_progress_caption" x="24" y="169" width="200" height="20" long_mode="dots" bind_text="meter_upgrade_progress_caption">
                    <style name="me106_text_14_gray_ba" />
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_label name="upgrade_progress_value" x="240" y="169" width="56" height="20" bind_text="meter_upgrade_progress_text">
                    <style name="me106_text_14_white_right" />
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
                </lv_label>
                <lv_bar name="upgrade_progress_bar" x="24" y="192" width="272" height="6" bind_value="meter_upgrade_progress" min_value="0" max_value="100" style_radius="3" style_border_width="0" style_pad_all="0" style_radius-indicator="3">
                    <style name="me106_theme_dark_control_track" />
                    <bind_style name="me106_theme_light_control_track" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_control_track" subject="meter_theme_index" ref_value="2" />
                    <style name="me106_slider_indicator" selector="indicator" />
                    <bind_style name="me106_theme_light_slider_indicator" selector="indicator" subject="meter_theme_index" ref_value="1" />
                    <bind_style name="me106_theme_alarm_slider_indicator" selector="indicator" subject="meter_theme_index" ref_value="2" />
                </lv_bar>
            </lv_obj>
        </lv_obj>
        <!-- 四键范围固定在 320x240 内；文字使用实际字体行高，并下移 1px 平衡 Harmony 字体底部留白。 -->
        <!-- primary_mode 选择主操作，XML 不抢写平台或 OTA 业务状态。 -->
        <lv_obj name="screen_settings_upgrade_bottom_bar" x="0" y="207" width="320" height="33" style_border_width="0" style_pad_all="0" style_radius="0" scrollable="false">
            <style name="me106_btn_flat_gray47" />
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2" />
        </lv_obj>
        <lv_button name="upgrade_btn_return" x="0" y="207" width="79" height="32" style_pad_all="0" style_border_width="0">
            <style name="me106_btn_flat_gray47" />
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2" />
            <bind_state_if_eq subject="meter_upgrade_busy" state="disabled" ref_value="1" />
            <lv_image name="upgrade_return_icon" src="meter_icon_return" align="center" style_transform_pivot_x="8" style_transform_pivot_y="7" style_transform_scale_x="230" style_transform_scale_y="230" />
            <lv_obj-screen_create_event screen="screen_settings" trigger="clicked" anim_type="none" />
        </lv_button>
        <lv_button name="upgrade_btn_placeholder_1" x="80" y="207" width="79" height="32" style_pad_all="0" style_border_width="0" clickable="false">
            <style name="me106_btn_flat_gray47" />
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2" />
        </lv_button>
        <lv_button name="upgrade_btn_recheck" x="160" y="207" width="79" height="32" style_pad_all="0" style_border_width="0">
            <style name="me106_btn_flat_gray47" />
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2" />
            <lv_label name="upgrade_recheck_label" align="center" y="1" width="63" height="content" long_mode="clip" text="重新检查">
                <style name="me106_text_14_white_center" />
            </lv_label>
            <bind_flag_if_not_eq subject="meter_upgrade_can_recheck" flag="hidden" ref_value="1" />
            <bind_state_if_eq subject="meter_upgrade_busy" state="disabled" ref_value="1" />
            <subject_set_int_event subject="meter_upgrade_request" value="1" trigger="clicked" />
        </lv_button>
        <lv_obj name="upgrade_primary_disabled" x="240" y="207" width="80" height="32" style_border_width="0" style_pad_all="0" style_radius="0" scrollable="false" clickable="false">
            <style name="me106_btn_flat_blue" />
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2" />
            <bind_flag_if_not_eq subject="meter_upgrade_primary_mode" flag="hidden" ref_value="0" />
            <lv_label name="upgrade_primary_disabled_text" bind_text="meter_upgrade_primary_text" align="center" y="1" width="64" height="content" long_mode="clip">
                <style name="me106_text_14_white_center" />
                <bind_style name="me106_theme_light_on_accent" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_on_accent" subject="meter_theme_index" ref_value="2" />
            </lv_label>
        </lv_obj>
        <lv_button name="upgrade_btn_yes" x="240" y="207" width="80" height="32" style_pad_all="0" style_border_width="0">
            <style name="me106_btn_flat_blue" />
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2" />
            <lv_label name="upgrade_primary_check_label" align="center" y="1" width="64" height="content" long_mode="clip" bind_text="meter_upgrade_primary_text">
                <style name="me106_text_14_white_center" />
            </lv_label>
            <bind_flag_if_not_eq subject="meter_upgrade_primary_mode" flag="hidden" ref_value="1" />
            <bind_state_if_eq subject="meter_upgrade_busy" state="disabled" ref_value="1" />
            <subject_set_int_event subject="meter_upgrade_request" value="1" trigger="clicked" />
        </lv_button>
        <lv_button name="upgrade_btn_go_wifi" x="240" y="207" width="80" height="32" style_pad_all="0" style_border_width="0">
            <style name="me106_btn_flat_blue" />
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2" />
            <lv_label name="upgrade_go_wifi_label" align="center" y="1" width="64" height="content" long_mode="clip" text="去联网">
                <style name="me106_text_14_white_center" />
            </lv_label>
            <bind_flag_if_not_eq subject="meter_upgrade_primary_mode" flag="hidden" ref_value="2" />
            <bind_state_if_eq subject="meter_upgrade_busy" state="disabled" ref_value="1" />
            <!-- 这里只跳转 WiFi 信息页；返回来源和联网后的自动查询留给下一步适配。 -->
            <lv_obj-screen_create_event screen="screen_settings_wifi_manage" trigger="clicked" anim_type="none" />
        </lv_button>
        <lv_button name="upgrade_btn_yes_start" x="240" y="207" width="80" height="32" style_pad_all="0" style_border_width="0">
            <style name="me106_btn_flat_blue" />
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2" />
            <lv_label name="upgrade_start_label" align="center" y="1" width="64" height="content" long_mode="clip" text="升级">
                <style name="me106_text_14_white_center" />
            </lv_label>
            <bind_flag_if_not_eq subject="meter_upgrade_primary_mode" flag="hidden" ref_value="3" />
            <bind_state_if_eq subject="meter_upgrade_busy" state="disabled" ref_value="1" />
            <subject_set_int_event subject="meter_upgrade_confirm_popup" value="1" trigger="clicked" />
        </lv_button>
        <lv_obj name="upgrade_busy_guard" x="0" y="207" width="320" height="33" style_border_width="0" style_pad_all="0" style_radius="0" scrollable="false" clickable="true">
            <style name="me106_theme_dark_busy_guard" />
            <bind_style name="me106_theme_light_busy_guard" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_busy_guard" subject="meter_theme_index" ref_value="2" />
            <bind_flag_if_not_eq subject="meter_upgrade_busy" flag="hidden" ref_value="1" />
            <lv_label text="升级中，请勿断电" align="center" y="1" width="320" height="content">
                <style name="me106_text_14_gray_ba_center" />
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
            </lv_label>
        </lv_obj>
        <!-- 确认层保留页头，覆盖内容和底栏；取消只关闭弹层，确认只提交刷写意图。 -->
        <lv_obj name="upgrade_confirm_overlay" x="0" y="45" width="320" height="195" style_border_width="0" style_pad_all="0" style_radius="0" scrollable="false" clickable="true">
            <style name="me106_fill_black" />
            <bind_style name="me106_theme_light_screen_bg" subject="meter_theme_index" ref_value="1" />
            <bind_style name="me106_theme_alarm_screen_bg" subject="meter_theme_index" ref_value="2" />
            <bind_flag_if_not_eq subject="meter_upgrade_confirm_popup" flag="hidden" ref_value="1" />
            <lv_label name="upgrade_confirm_title" x="24" y="12" width="272" height="26" text="确认升级此固件？">
                <style name="me106_text_18_cyan" />
                <bind_style name="me106_theme_light_info_text" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_info_text" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_label name="upgrade_confirm_current_label" x="24" y="50" width="54" height="22" text="当前：">
                <style name="me106_text_14_gray_ba" />
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_label name="upgrade_confirm_current_value" x="82" y="49" width="214" height="22" long_mode="dots" bind_text="meter_upgrade_current_version">
                <style name="me106_text_16_white" />
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_label name="upgrade_confirm_target_label" x="24" y="80" width="54" height="22" text="目标：">
                <style name="me106_text_14_gray_ba" />
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_label name="upgrade_confirm_target_value" x="82" y="79" width="214" height="42" long_mode="wrap" bind_text="meter_upgrade_new_version">
                <style name="me106_text_16_white" />
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_label name="upgrade_confirm_power_hint" x="24" y="126" width="272" height="22" long_mode="wrap" text="升级后自动重启，请保持供电。">
                <style name="me106_text_14_gray_ba" />
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2" />
            </lv_label>
            <lv_button name="upgrade_confirm_cancel" x="0" y="162" width="159" height="32" style_pad_all="0" style_border_width="0">
                <style name="me106_btn_flat_gray47" />
                <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2" />
                <lv_label align="center" y="1" width="159" height="content" text="取消">
                    <style name="me106_text_14_white_center" />
                </lv_label>
                <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="clicked" />
            </lv_button>
            <lv_button name="upgrade_confirm_yes" x="160" y="162" width="160" height="32" style_pad_all="0" style_border_width="0">
                <style name="me106_btn_flat_blue" />
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1" />
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2" />
                <lv_label align="center" y="1" width="160" height="content" text="确认升级">
                    <style name="me106_text_14_white_center" />
                </lv_label>
                <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="clicked" />
                <subject_set_int_event subject="meter_upgrade_request" value="2" trigger="clicked" />
            </lv_button>
        </lv_obj>
    </view>
</screen>
