<screen>
    <animations>
        <timeline name="content_open">
            <animation target="page_content" prop="opa" start="0" end="255" duration="110" early_apply="true"/>
            <animation target="page_content" prop="translate_y" start="4" end="0" duration="110" early_apply="true"/>
        </timeline>
    </animations>

    <view width="320" height="240">
        <style name="me106_fill_gray1f"/>
        <bind_style name="me106_theme_light_screen_bg" subject="meter_theme_index" ref_value="1"/>
        <bind_style name="me106_theme_alarm_screen_bg" subject="meter_theme_index" ref_value="2"/>
        <play_timeline_event target="self" timeline="content_open" trigger="screen_loaded"/>
        <subject_set_int_event subject="meter_upgrade_request" value="0" trigger="screen_loaded"/>
        <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="screen_loaded"/>

        <!-- UI 只展示 OTA 状态并提交“检查/确认升级”意图，平台和 Flash 操作由逻辑层继续下沉。 -->
        <lv_obj name="page_content" x="0" y="0" width="320" height="207" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
            <lv_label text="&#x56FA;&#x4EF6;&#x5347;&#x7EA7;" x="152" y="12" width="144">
                <style name="me106_text_16_white_right"/>
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
            </lv_label>

            <lv_image src="meter_icon_update" x="25" y="17" style_transform_pivot_x="8" style_transform_pivot_y="8" style_transform_scale_x="220" style_transform_scale_y="220">
                <style name="me106_icon_cyan"/>
            </lv_image>
            <lv_label bind_text="meter_upgrade_status_text" x="52" y="17" width="184">
                <style name="me106_text_14_gray_ba"/>
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
            </lv_label>

            <lv_obj name="upgrade_info_panel" x="24" y="43" width="272" height="105" style_pad_all="0" scrollable="false">
                <style name="me106_panel_soft_r8"/>
                <bind_style name="me106_theme_light_soft_panel" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_soft_panel" subject="meter_theme_index" ref_value="2"/>

                <lv_label text="&#x5F53;&#x524D;&#x7248;&#x672C;" x="14" y="10" width="70">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_upgrade_current_version" x="88" y="10" width="56">
                    <style name="me106_text_14_white"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label text="&#x76EE;&#x6807;&#x7248;&#x672C;" x="150" y="10" width="70">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_upgrade_new_version" x="220" y="10" width="46">
                    <style name="me106_text_14_cyan"/>
                </lv_label>

                <lv_label text="&#x56FA;&#x4EF6;&#x5927;&#x5C0F;" x="14" y="36" width="70">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_upgrade_file_size_text" x="88" y="36" width="170">
                    <style name="me106_text_14_white"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>

                <lv_label text="&#x66F4;&#x65B0;&#x8BF4;&#x660E;" x="14" y="62" width="70">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_upgrade_release_notes" x="88" y="62" width="170" height="36" long_mode="wrap">
                    <style name="me106_text_14_white"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
            </lv_obj>

            <!-- 进度由逻辑层更新；空闲时保持 0%，下载/写入时显示实际阶段和百分比。 -->
            <lv_bar name="upgrade_progress_bar" x="24" y="155" width="220" height="8" bind_value="meter_upgrade_progress" min_value="0" max_value="100" style_radius="4" style_bg_color="0x30343B" style_bg_opa="255" style_border_width="0" style_pad_all="0" style_bg_color-indicator="0x20D3D5" style_bg_opa-indicator="255" style_radius-indicator="4"/>
            <lv_label bind_text="meter_upgrade_progress_text" x="250" y="150" width="46">
                <style name="me106_text_14_cyan"/>
            </lv_label>

            <!-- 各状态使用独立按钮叠层，查询和升级期间不会重复提交点击事件。 -->
            <lv_button name="upgrade_btn_check" x="176" y="171" width="120" height="30">
                <style name="me106_panel_blue_r6"/>
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="0"/>
                <lv_label text="&#x68C0;&#x67E5;&#x66F4;&#x65B0;" align="center" width="120"><style name="me106_text_16_white_center"/></lv_label>
                <subject_set_int_event subject="meter_upgrade_request" value="1" trigger="clicked"/>
                <subject_set_int_event subject="meter_upgrade_ui_state" value="1" trigger="clicked"/>
                <subject_set_string_event subject="meter_upgrade_status_text" value="&#x6B63;&#x5728;&#x68C0;&#x67E5;&#x66F4;&#x65B0;" trigger="clicked"/>
            </lv_button>
            <lv_button name="upgrade_btn_check_again" x="176" y="171" width="120" height="30">
                <style name="me106_panel_blue_r6"/>
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="2"/>
                <lv_label text="&#x518D;&#x6B21;&#x68C0;&#x67E5;" align="center" width="120"><style name="me106_text_16_white_center"/></lv_label>
                <subject_set_int_event subject="meter_upgrade_request" value="1" trigger="clicked"/>
                <subject_set_int_event subject="meter_upgrade_ui_state" value="1" trigger="clicked"/>
                <subject_set_string_event subject="meter_upgrade_status_text" value="&#x6B63;&#x5728;&#x68C0;&#x67E5;&#x66F4;&#x65B0;" trigger="clicked"/>
            </lv_button>
            <lv_button name="upgrade_btn_checking" x="176" y="171" width="120" height="30">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="1"/>
                <lv_label text="&#x6B63;&#x5728;&#x68C0;&#x67E5;" align="center" width="120"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
            <lv_button name="upgrade_btn_start" x="176" y="171" width="120" height="30">
                <style name="me106_panel_blue_r6"/>
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="3"/>
                <lv_label text="&#x7ACB;&#x5373;&#x5347;&#x7EA7;" align="center" width="120"><style name="me106_text_16_white_center"/></lv_label>
                <subject_set_int_event subject="meter_upgrade_confirm_popup" value="1" trigger="clicked"/>
            </lv_button>
            <lv_button name="upgrade_btn_busy_start" x="176" y="171" width="120" height="30">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="4"/>
                <lv_label text="&#x6B63;&#x5728;&#x542F;&#x52A8;&#x5347;&#x7EA7;" align="center" width="120"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
            <lv_button name="upgrade_btn_busy_download" x="176" y="171" width="120" height="30">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="5"/>
                <lv_label text="&#x6B63;&#x5728;&#x4E0B;&#x8F7D;" align="center" width="120"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
            <lv_button name="upgrade_btn_busy_write" x="176" y="171" width="120" height="30">
                <style name="me106_btn_flat_gray47"/>
                <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="6"/>
                <lv_label text="&#x6B63;&#x5728;&#x5199;&#x5165;" align="center" width="120"><style name="me106_text_14_gray_ba"/></lv_label>
            </lv_button>
        </lv_obj>

        <!-- 底部返回保留；真正开始 OTA 后由覆盖层拦截，避免退出或重复操作。 -->
        <lv_obj name="screen_settings_upgrade_bottom_bar" x="0" y="207" width="320" height="33" style_border_width="0" style_pad_all="0" scrollable="false">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
        </lv_obj>
        <lv_button name="upgrade_btn_return" x="0" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_icon_return" align="center" style_transform_pivot_x="8" style_transform_pivot_y="7" style_transform_scale_x="230" style_transform_scale_y="230"/>
            <lv_obj-screen_create_event screen="screen_settings" trigger="clicked" anim_type="none"/>
        </lv_button>
        <lv_button name="upgrade_btn_placeholder_1" x="80" y="207" width="79" height="32"><style name="me106_btn_flat_gray47"/></lv_button>
        <lv_button name="upgrade_btn_placeholder_2" x="160" y="207" width="79" height="32"><style name="me106_btn_flat_gray47"/></lv_button>
        <lv_button name="upgrade_btn_placeholder_3" x="240" y="207" width="80" height="32"><style name="me106_btn_flat_gray47"/></lv_button>

        <lv_obj name="upgrade_busy_guard_start" x="0" y="207" width="320" height="33" style_bg_color="0x30343B" style_bg_opa="255" style_border_width="0" style_pad_all="0" scrollable="false">
            <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="4"/>
            <lv_label text="&#x5347;&#x7EA7;&#x4E2D;&#xFF0C;&#x8BF7;&#x52FF;&#x64CD;&#x4F5C;" align="center" width="320"><style name="me106_text_14_gray_ba"/></lv_label>
        </lv_obj>
        <lv_obj name="upgrade_busy_guard_download" x="0" y="207" width="320" height="33" style_bg_color="0x30343B" style_bg_opa="255" style_border_width="0" style_pad_all="0" scrollable="false">
            <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="5"/>
            <lv_label text="&#x5347;&#x7EA7;&#x4E2D;&#xFF0C;&#x8BF7;&#x52FF;&#x64CD;&#x4F5C;" align="center" width="320"><style name="me106_text_14_gray_ba"/></lv_label>
        </lv_obj>
        <lv_obj name="upgrade_busy_guard_write" x="0" y="207" width="320" height="33" style_bg_color="0x30343B" style_bg_opa="255" style_border_width="0" style_pad_all="0" scrollable="false">
            <bind_flag_if_not_eq subject="meter_upgrade_ui_state" flag="hidden" ref_value="6"/>
            <lv_label text="&#x5347;&#x7EA7;&#x4E2D;&#xFF0C;&#x8BF7;&#x52FF;&#x65AD;&#x7535;" align="center" width="320"><style name="me106_text_14_gray_ba"/></lv_label>
        </lv_obj>

        <!-- 二次确认只提交“立即升级”意图，不直接触发下载或写 Flash。 -->
        <lv_obj name="upgrade_confirm_mask" x="0" y="0" width="320" height="240" style_bg_color="0x000000" style_bg_opa="190" style_border_width="0" style_pad_all="0" scrollable="false">
            <bind_flag_if_not_eq subject="meter_upgrade_confirm_popup" flag="hidden" ref_value="1"/>
        </lv_obj>
        <lv_obj name="upgrade_confirm_dialog" x="34" y="48" width="252" height="142" style_pad_all="0" style_border_width="0" scrollable="false">
            <style name="me106_panel_soft_r8"/>
            <bind_style name="me106_theme_light_soft_panel" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_soft_panel" subject="meter_theme_index" ref_value="2"/>
            <bind_flag_if_not_eq subject="meter_upgrade_confirm_popup" flag="hidden" ref_value="1"/>
            <lv_image src="meter_icon_warning" x="112" y="14"/>
            <lv_label text="&#x5347;&#x7EA7;&#x8FC7;&#x7A0B;&#x4E2D;&#x8BF7;&#x52FF;&#x65AD;&#x7535;" x="24" y="48" width="204">
                <style name="me106_text_16_white_center"/>
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
            </lv_label>
            <lv_label text="&#x786E;&#x5B9A;&#x7ACB;&#x5373;&#x5347;&#x7EA7;&#x5417;&#xFF1F;" x="24" y="72" width="204">
                <style name="me106_text_14_gray_ba"/>
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
            </lv_label>
            <lv_button name="upgrade_confirm_cancel" x="18" y="100" width="98" height="30">
                <style name="me106_btn_flat_gray47"/>
                <lv_label text="&#x53D6;&#x6D88;" align="center" width="98"><style name="me106_text_14_gray_ba"/></lv_label>
                <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="clicked"/>
            </lv_button>
            <lv_button name="upgrade_confirm_yes" x="136" y="100" width="98" height="30">
                <style name="me106_panel_blue_r6"/>
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
                <lv_label text="&#x7ACB;&#x5373;&#x5347;&#x7EA7;" align="center" width="98"><style name="me106_text_14_white_center"/></lv_label>
                <subject_set_int_event subject="meter_upgrade_confirm_popup" value="0" trigger="clicked"/>
                <subject_set_int_event subject="meter_upgrade_request" value="2" trigger="clicked"/>
                <subject_set_int_event subject="meter_upgrade_ui_state" value="4" trigger="clicked"/>
                <subject_set_string_event subject="meter_upgrade_status_text" value="&#x6B63;&#x5728;&#x542F;&#x52A8;&#x5347;&#x7EA7;" trigger="clicked"/>
            </lv_button>
        </lv_obj>
    </view>
</screen>
