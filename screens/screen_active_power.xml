<screen>
    <animations>
        <timeline name="measurement_header_open">
            <animation target="active_header" prop="opa" start="0" end="255" duration="120" early_apply="true"/>
        </timeline>
    </animations>
    <view width="320" height="240">
        <style name="me106_fill_black"/>
        <bind_style name="me106_theme_light_screen_bg" subject="meter_theme_index" ref_value="1"/>
        <bind_style name="me106_theme_alarm_screen_bg" subject="meter_theme_index" ref_value="2"/>
        <play_timeline_event target="self" timeline="measurement_header_open" trigger="screen_loaded"/>
        <!-- UI分组：页面内容区。视觉布局与底部固定硬按键导航分离。 -->
        <lv_obj name="page_content" x="0" y="0" width="320" height="207" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
        <!-- 页面标题 -->
        <lv_obj name="active_header" x="0" y="0" width="320" height="44" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
        <lv_image name="active_brand_logo" src="meter_brand_logo" x="20" y="17"/>
        <lv_label text="&#x6709;&#x529F;&#x529F;&#x7387;(kW)" x="156" y="17" width="140" name="active_power_title_label">
            <style name="me106_text_16_white_right"/>
            <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        </lv_obj>

        <!-- 左上数据组 -->
        <lv_label text="A&#x76F8;" x="16" y="53" name="active_power_phase_a_label">
            <style name="me106_text_18_yellow"/>
            <bind_style name="me106_theme_light_phase_a" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_phase_a" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <!-- UI告警点：功率越限由逻辑层置位，页面只显示红点提示。 -->
        <lv_label name="active_power_a_value" text="0.000" x="56" y="53">
            <style name="me106_text_18_white"/>
            <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_image name="active_a_power_issue" src="meter_icon_warning" x="108" y="53"><bind_flag_if_not_eq subject="meter_active_a_power_issue" flag="hidden" ref_value="1"/></lv_image>

        <!-- 右上数据组 -->
        <lv_label text="B&#x76F8;" x="16" y="91" name="active_power_phase_b_label">
            <style name="me106_text_18_green"/>
            <bind_style name="me106_theme_light_phase_b" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_phase_b" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_label name="active_power_b_value" text="0.000" x="56" y="91">
            <style name="me106_text_18_white"/>
            <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_image name="active_b_power_issue" src="meter_icon_warning" x="108" y="91"><bind_flag_if_not_eq subject="meter_active_b_power_issue" flag="hidden" ref_value="1"/></lv_image>

        <!-- 左下数据组 -->
        <lv_label text="C&#x76F8;" x="16" y="129" name="active_power_phase_c_label">
            <style name="me106_text_18_red"/>
            <bind_style name="me106_theme_light_phase_c" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_phase_c" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_label name="active_power_c_value" text="0.000" x="56" y="129">
            <style name="me106_text_18_white"/>
            <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_image name="active_c_power_issue" src="meter_icon_warning" x="108" y="129"><bind_flag_if_not_eq subject="meter_active_c_power_issue" flag="hidden" ref_value="1"/></lv_image>

        <!-- 右下数据组 -->
        <lv_label text="&#x5408;&#x76F8;" x="16" y="167" name="active_power_total_label">
            <style name="me106_text_18_gray_ba"/>
            <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_label name="active_power_total_value" text="0.000" x="56" y="167">
            <style name="me106_text_18_white"/>
            <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
        </lv_label>
        <lv_image name="active_total_power_issue" src="meter_icon_warning" x="108" y="167"><bind_flag_if_not_eq subject="meter_active_total_power_issue" flag="hidden" ref_value="1"/></lv_image>

        <!-- 标准 P-Q 四象限方向图；默认收回原点，真实向量由运行时适配层同步更新。 -->
        <lv_obj name="active_power_quadrant_panel" x="128" y="47" width="178" height="151" style_bg_opa="0" style_border_width="1" style_pad_all="0" scrollable="false">
            <style name="me106_quadrant_panel"/>
            <bind_style name="me106_quadrant_light_panel" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_quadrant_cyber_panel" subject="meter_theme_index" ref_value="2"/>
        <!-- 方向未确认时不显示伪造的 PF/角度；有效状态由运行时适配层覆盖。 -->
        <lv_label text="PF --" x="8" y="5" width="76" height="18" name="active_power_quadrant_pf"><style name="me106_quadrant_status_pf"/><bind_style name="me106_quadrant_light_status_pf" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_status_pf" subject="meter_theme_index" ref_value="2"/></lv_label>
        <lv_label text="&#x3C6; --&#xB0;" x="98" y="5" width="70" height="18" name="active_power_quadrant_angle"><style name="me106_quadrant_status_angle"/><bind_style name="me106_quadrant_light_status_angle" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_status_angle" subject="meter_theme_index" ref_value="2"/></lv_label>
        <lv_obj name="active_power_quadrant_circle" x="38" y="28" width="100" height="100" style_radius="50" style_bg_opa="0" style_border_width="1"><style name="me106_quadrant_circle"/><bind_style name="me106_quadrant_light_circle" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_circle" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_label text="I" x="140" y="28" width="24" name="active_power_quadrant_i"><style name="me106_quadrant_quadrant_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="II" x="10" y="28" width="28" name="active_power_quadrant_ii"><style name="me106_quadrant_quadrant_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="III" x="10" y="108" width="34" name="active_power_quadrant_iii"><style name="me106_quadrant_quadrant_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="IV" x="140" y="108" width="28" name="active_power_quadrant_iv"><style name="me106_quadrant_quadrant_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_obj name="active_power_quadrant_axis_x_left" x="18" y="76" width="65" height="3" style_radius="0" style_border_width="0"><style name="me106_quadrant_axis_warm"/><bind_style name="me106_quadrant_light_axis" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_axis" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_axis_x_right" x="93" y="76" width="71" height="3" style_radius="0" style_border_width="0"><style name="me106_quadrant_axis_warm"/><bind_style name="me106_quadrant_light_axis" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_axis" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_axis_y_top" x="87" y="18" width="3" height="56" style_radius="0" style_border_width="0"><style name="me106_quadrant_axis_warm"/><bind_style name="me106_quadrant_light_axis" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_axis" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_axis_y_bottom" x="87" y="82" width="3" height="56" style_radius="0" style_border_width="0"><style name="me106_quadrant_axis_warm"/><bind_style name="me106_quadrant_light_axis" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_axis" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <!-- 圆周四个固定参考点：仅标识坐标边界，不代表实时采样点。 -->
            <lv_obj name="active_power_quadrant_reference_top" x="85" y="25" width="6" height="6" style_border_width="0"><style name="me106_quadrant_reference_point"/><bind_style name="me106_quadrant_light_reference" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_reference" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_reference_bottom" x="85" y="125" width="6" height="6" style_border_width="0"><style name="me106_quadrant_reference_point"/><bind_style name="me106_quadrant_light_reference" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_reference" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_reference_left" x="35" y="75" width="6" height="6" style_border_width="0"><style name="me106_quadrant_reference_point"/><bind_style name="me106_quadrant_light_reference" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_reference" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_reference_right" x="135" y="75" width="6" height="6" style_border_width="0"><style name="me106_quadrant_reference_point"/><bind_style name="me106_quadrant_light_reference" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_reference" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_origin_glow" x="79" y="68" width="18" height="18" style_radius="9" style_border_width="0"><style name="me106_quadrant_origin_glow"/><bind_style name="me106_quadrant_light_origin_glow" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_origin" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <lv_obj name="active_power_quadrant_origin_core" x="84" y="73" width="8" height="8" style_radius="4" style_border_width="0"><style name="me106_quadrant_origin_core"/><bind_style name="me106_quadrant_light_origin_core" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_origin" subject="meter_theme_index" ref_value="2"/></lv_obj>
            <!-- 无有效方向时向量杆收回原点并隐藏箭头边，避免首帧闪现 45° 示意。 -->
            <lv_line name="active_power_quadrant_vector_q1" points="(88 77) (88 77)" y_invert="false"><style name="me106_quadrant_arrow"/><style name="me106_quadrant_vector_gold"/><bind_style name="me106_quadrant_light_vector" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_vector" subject="meter_theme_index" ref_value="2"/></lv_line>
            <lv_line name="active_power_quadrant_vector_q1_head_a" x="113" y="42" points="(10 0) (0 3)" y_invert="false" hidden="true"><style name="me106_quadrant_arrow"/><style name="me106_quadrant_vector_gold"/><bind_style name="me106_quadrant_light_vector" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_vector" subject="meter_theme_index" ref_value="2"/></lv_line>
            <lv_line name="active_power_quadrant_vector_q1_head_b" x="113" y="42" points="(10 0) (7 10)" y_invert="false" hidden="true"><style name="me106_quadrant_arrow"/><style name="me106_quadrant_vector_gold"/><bind_style name="me106_quadrant_light_vector" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_vector" subject="meter_theme_index" ref_value="2"/></lv_line>
            <lv_label text="+Q" x="94" y="14" width="30" name="active_power_quadrant_q_positive"><style name="me106_quadrant_axis_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="-Q" x="94" y="132" width="30" name="active_power_quadrant_q_negative"><style name="me106_quadrant_axis_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="-P" x="16" y="87" width="28" name="active_power_quadrant_p_negative"><style name="me106_quadrant_axis_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
            <lv_label text="+P" x="140" y="87" width="28" name="active_power_quadrant_p_positive"><style name="me106_quadrant_axis_text"/><bind_style name="me106_quadrant_light_text" subject="meter_theme_index" ref_value="1"/><bind_style name="me106_quadrant_cyber_text" subject="meter_theme_index" ref_value="2"/></lv_label>
        </lv_obj>

        <!-- 底部导航 -->
        </lv_obj>

        <!-- UI分组：底部硬按键区。按钮只发出导航/选择意图，不直接处理硬件。 -->
        <lv_obj name="screen_active_power_bottom_bar" x="0" y="207" width="320" height="33" style_border_width="0" style_pad_all="0" scrollable="false">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
        </lv_obj>
        <lv_button name="active_btn_settings" x="0" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <style name="me106_btn_flat_blue"/>
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_setting" align="center" x="0" y="0" style_transform_pivot_x="16" style_transform_pivot_y="16" style_transform_scale_x="110" style_transform_scale_y="110"/>
            <lv_obj-screen_create_event screen="screen_settings" trigger="clicked" anim_type="none"/>
        </lv_button>

        <lv_button name="active_btn_reserved" x="80" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_menu" align="center" x="0" y="0" style_transform_pivot_x="12" style_transform_pivot_y="12" style_transform_scale_x="150" style_transform_scale_y="150"/>
            <lv_obj-screen_create_event screen="screen_function_menu" trigger="clicked" anim_type="none"/>
        </lv_button>

        <lv_button name="active_btn_prev" x="160" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_arrow_left" align="center" y="0" style_transform_pivot_x="10" style_transform_pivot_y="14" style_transform_scale_x="120" style_transform_scale_y="120"/>
            <lv_obj-screen_create_event screen="screen_home" trigger="clicked" anim_type="none"/>
        </lv_button>

        <lv_button name="active_btn_next" x="240" y="207" width="80" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_arrow_right" align="center" y="0" style_transform_pivot_x="10" style_transform_pivot_y="14" style_transform_scale_x="120" style_transform_scale_y="120"/>
            <lv_obj-screen_create_event screen="screen_reactive_power" trigger="clicked" anim_type="none"/>
        </lv_button>
    </view>
</screen>
