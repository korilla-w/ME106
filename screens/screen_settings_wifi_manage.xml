<screen>
    <view width="320" height="240">
        <style name="me106_fill_gray1f"/>
        <bind_style name="me106_theme_light_screen_bg" subject="meter_theme_index" ref_value="1"/>
        <bind_style name="me106_theme_alarm_screen_bg" subject="meter_theme_index" ref_value="2"/>
        <subject_set_int_event subject="meter_wifi_manage_action" value="0" trigger="screen_loaded"/>

        <!-- C61 WiFi 信息页：复用原 WiFi 配置页版式，显示热点、密码、IP 和连接/断开按键。 -->
        <lv_obj name="page_content" x="0" y="0" width="320" height="207" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
            <lv_label text="WiFi&#x4FE1;&#x606F;" x="152" y="17" width="144">
                <style name="me106_text_16_white_right"/>
                <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
            </lv_label>

            <lv_obj name="wifi_manage_icon_halo" x="24" y="42" width="42" height="42" style_radius="12" style_border_width="0" style_pad_all="0" scrollable="false">
                <style name="me106_theme_dark_info_soft"/>
                <bind_style name="me106_theme_light_info_soft" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_info_soft" subject="meter_theme_index" ref_value="2"/>
            </lv_obj>
            <lv_image src="meter_icon_wifi" x="35" y="53" style_transform_pivot_x="8" style_transform_pivot_y="8" style_transform_scale_x="220" style_transform_scale_y="220">
                <style name="me106_theme_dark_info_icon"/>
                <bind_style name="me106_theme_light_info_icon" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_info_icon" subject="meter_theme_index" ref_value="2"/>
            </lv_image>
            <lv_label text="&#x7F51;&#x7EDC;&#x4FE1;&#x606F;" x="82" y="46" width="92">
                <style name="me106_text_18_cyan"/>
                <bind_style name="me106_theme_light_info_text" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_info_text" subject="meter_theme_index" ref_value="2"/>
            </lv_label>
            <lv_label bind_text="meter_wifi_manage_status_text" x="82" y="71" width="170">
                <style name="me106_text_14_gray_ba"/>
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
            </lv_label>

            <lv_obj name="wifi_manage_info_band" x="24" y="96" width="272" height="74" style_pad_all="0" scrollable="false">
                <style name="me106_panel_soft_r8"/>
                <bind_style name="me106_theme_light_soft_panel" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_soft_panel" subject="meter_theme_index" ref_value="2"/>
            </lv_obj>

            <lv_obj name="wifi_manage_source_dot" x="40" y="111" width="7" height="7" style_radius="4" style_border_width="0" scrollable="false">
                <style name="me106_theme_dark_info"/>
                <bind_style name="me106_theme_light_info" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_info" subject="meter_theme_index" ref_value="2"/>
            </lv_obj>
            <lv_obj name="wifi_manage_source_panel" x="56" y="102" width="224" height="22" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
                <lv_label text="&#x70ED;&#x70B9;" align="left_mid" x="0" y="0" width="82">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_wifi_manage_hotspot_state_text" align="right_mid" x="0" y="0" width="224">
                    <style name="me106_text_16_white_right"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
            </lv_obj>

            <lv_obj name="wifi_manage_ssid_dot" x="40" y="135" width="7" height="7" style_radius="4" style_border_width="0" scrollable="false">
                <style name="me106_btn_flat_blue"/>
                <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
            </lv_obj>
            <lv_obj name="wifi_manage_ssid_panel" x="56" y="126" width="224" height="22" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
                <lv_label text="&#x5BC6;&#x7801;" align="left_mid" x="0" y="0" width="82">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_wifi_manage_password_state_text" align="right_mid" x="0" y="0" width="224">
                    <style name="me106_text_16_white_right"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
            </lv_obj>

            <lv_obj name="wifi_manage_pass_dot" x="40" y="159" width="7" height="7" style_radius="4" style_border_width="0" scrollable="false">
                <style name="me106_theme_dark_success"/>
                <bind_style name="me106_theme_light_success" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_success" subject="meter_theme_index" ref_value="2"/>
            </lv_obj>
            <lv_obj name="wifi_manage_pass_panel" x="56" y="150" width="224" height="22" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false">
                <lv_label text="IP" align="left_mid" x="0" y="0" width="82">
                    <style name="me106_text_14_gray_8f"/>
                    <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
                <lv_label bind_text="meter_wifi_manage_ip_text" align="right_mid" x="0" y="0" width="224">
                    <style name="me106_text_16_white_right"/>
                    <bind_style name="me106_theme_light_text" subject="meter_theme_index" ref_value="1"/>
                    <bind_style name="me106_theme_alarm_text" subject="meter_theme_index" ref_value="2"/>
                </lv_label>
            </lv_obj>

            <lv_label text="&#x8BF7;&#x7528;&#x4E0A;&#x4F4D;&#x673A;&#x914D;&#x7F6E;" x="24" y="184" width="272">
                <style name="me106_text_14_gray_ba"/>
                <bind_style name="me106_theme_light_muted" subject="meter_theme_index" ref_value="1"/>
                <bind_style name="me106_theme_alarm_muted" subject="meter_theme_index" ref_value="2"/>
            </lv_label>
        </lv_obj>

        <lv_obj name="screen_settings_wifi_manage_bottom_bar" x="0" y="207" width="320" height="33" style_border_width="0" style_pad_all="0" scrollable="false">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
        </lv_obj>
        <lv_button name="wifi_manage_btn_return" x="0" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_icon_return" align="center" style_transform_pivot_x="8" style_transform_pivot_y="7" style_transform_scale_x="230" style_transform_scale_y="230"/>
            <lv_obj-screen_create_event screen="screen_settings" trigger="clicked" anim_type="fade_out" duration="105"/>
        </lv_button>
        <lv_button name="wifi_manage_btn_placeholder_1" x="80" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
        </lv_button>
        <lv_button name="wifi_manage_btn_disconnect" x="160" y="207" width="79" height="32">
            <style name="me106_btn_flat_gray47"/>
            <bind_style name="me106_theme_light_nav" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_nav" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_icon_wifi_disconnect" align="center" style_transform_pivot_x="16" style_transform_pivot_y="16"/>
            <subject_set_int_event subject="meter_wifi_manage_action" value="1" trigger="clicked"/>
        </lv_button>
        <lv_button name="wifi_manage_btn_connect" x="240" y="207" width="80" height="32">
            <style name="me106_btn_flat_blue"/>
            <bind_style name="me106_theme_light_accent" subject="meter_theme_index" ref_value="1"/>
            <bind_style name="me106_theme_alarm_accent" subject="meter_theme_index" ref_value="2"/>
            <lv_image src="meter_icon_wifi_connect" align="center" style_transform_pivot_x="16" style_transform_pivot_y="16"/>
            <subject_set_int_event subject="meter_wifi_manage_action" value="2" trigger="clicked"/>
        </lv_button>
    </view>
</screen>
